{
  "name": "@design-assets/demo-angular",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "yarn copy:assets",
    "copy:assets": "yarn workspace @design-assets/core generate && yarn workspace @design-assets/core design-assets copy ../../apps/demo-angular/public/design-assets",
    "dev": "yarn copy:assets && ng serve --port 4200",
    "prebuild": "yarn copy:assets",
    "build": "ng build",
    "typecheck": "ng build --configuration development",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@design-assets/angular": "workspace:*",
    "@design-assets/core": "workspace:*",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@design-assets/eslint-config": "workspace:*",
    "@design-assets/typescript-config": "workspace:*",
    "eslint": "^9.28.0",
    "typescript": "~5.8.3"
  }
}
