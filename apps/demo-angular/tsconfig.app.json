{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "noEmit": false,
    "declaration": false,
    "declarationMap": false,
    "types": [],
    "paths": {
      "@petrvocelka/design-assets-angular": ["../../packages/angular/src/index.ts"],
      "@petrvocelka/design-assets-angular/*": ["../../packages/angular/src/*"],
      "@petrvocelka/design-assets-core": ["../../packages/core/src/index.ts"],
      "@petrvocelka/design-assets-core/*": ["../../packages/core/*"]
    }
  },
  "files": ["src/main.ts"],
  "include": ["src/**/*.d.ts"]
}
