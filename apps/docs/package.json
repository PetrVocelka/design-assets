{
  "name": "@design-assets/docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "yarn copy:assets",
    "copy:assets": "yarn workspace @design-assets/core generate && yarn workspace @design-assets/core design-assets copy ../../apps/docs/public/design-assets",
    "dev": "yarn copy:assets && storybook dev -p 6006",
    "prebuild": "yarn copy:assets",
    "build": "storybook build",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@design-assets/core": "workspace:*",
    "@design-assets/react": "workspace:*",
    "@design-assets/web-components": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@design-assets/eslint-config": "workspace:*",
    "@design-assets/tailwind-preset": "workspace:*",
    "@design-assets/typescript-config": "workspace:*",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.28.0",
    "postcss": "^8.5.4",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
