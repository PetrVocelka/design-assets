{
  "name": "@design-assets/demo-vanilla",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "yarn copy:assets",
    "copy:assets": "yarn workspace @petrvocelka/design-assets-core generate && yarn workspace @petrvocelka/design-assets-core design-assets copy ../../apps/demo-vanilla/public/design-assets",
    "dev": "yarn copy:assets && vite",
    "prebuild": "yarn copy:assets",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@petrvocelka/design-assets-core": "workspace:*",
    "@petrvocelka/design-assets-web-components": "workspace:*"
  },
  "devDependencies": {
    "@design-assets/eslint-config": "workspace:*",
    "@design-assets/typescript-config": "workspace:*",
    "eslint": "^9.28.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
