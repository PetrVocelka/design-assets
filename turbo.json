{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["generate"]
    },
    "test:e2e": {
      "dependsOn": ["generate", "build"],
      "cache": false
    },
    "generate": {
      "dependsOn": ["^generate"],
      "cache": false
    },
    "validate": {
      "dependsOn": ["generate"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
