{
  "name": "design-assets",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:pages": "yarn workspace @design-assets/demo-react build && yarn workspace @petrvocelka/design-assets-web-components build && yarn workspace @design-assets/docs build && node scripts/build-pages.mjs",
    "lint": "turbo run lint --continue",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "generate": "turbo run generate",
    "validate": "turbo run validate",
    "changeset": "changeset",
    "version-packages": "changeset version && yarn generate",
    "release": "changeset publish",
    "design-assets": "yarn workspace @petrvocelka/design-assets-core design-assets"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@design-assets/eslint-config": "workspace:*",
    "turbo": "^2.5.4"
  },
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=20"
  }
}
