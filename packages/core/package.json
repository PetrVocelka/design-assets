{
  "name": "@petrvocelka/design-assets-core",
  "version": "0.2.0",
  "description": "Framework-agnostic SVG asset core with typed names, versioned href helpers, generated files, validation, and copy CLI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "design-assets": "./dist/bin/copy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./href": {
      "types": "./dist/href.d.ts",
      "import": "./dist/href.js",
      "default": "./dist/href.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js",
      "default": "./dist/names.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js",
      "default": "./dist/manifest.js"
    },
    "./version": {
      "types": "./dist/version.d.ts",
      "import": "./dist/version.js",
      "default": "./dist/version.js"
    },
    "./builder": {
      "types": "./builder/asset-pack-builder.d.ts",
      "import": "./builder/asset-pack-builder.mjs",
      "default": "./builder/asset-pack-builder.mjs"
    },
    "./svg/*": "./generated/svg/*",
    "./generated/inline/*.js": {
      "types": "./dist/generated/inline/*.d.ts",
      "import": "./dist/generated/inline/*.js"
    }
  },
  "files": [
    "builder",
    "dist",
    "generated/svg",
    "generated/manifest.json"
  ],
  "scripts": {
    "generate": "tsx scripts/generate.ts",
    "validate": "tsx scripts/validate.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src scripts bin --ext .ts",
    "design-assets": "tsx bin/copy.ts"
  },
  "devDependencies": {
    "@design-assets/eslint-config": "workspace:*",
    "@design-assets/typescript-config": "workspace:*",
    "@types/node": "^22.15.29",
    "eslint": "^9.28.0",
    "flag-icons": "^7.3.2",
    "svgo": "^3.3.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
