{
  "name": "@petrvocelka/design-assets-react",
  "version": "0.1.0",
  "description": "React renderers for typed SVG design assets with external use/img modes and critical inline components.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./inline": {
      "types": "./dist/inline/index.d.ts",
      "import": "./dist/inline/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "tsx scripts/generate-inline-components.ts",
    "build": "yarn generate && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "@petrvocelka/design-assets-core": ">=0.1.0 <1",
    "react": ">=18"
  },
  "dependencies": {
    "@petrvocelka/design-assets-core": "0.1.0"
  },
  "devDependencies": {
    "@design-assets/eslint-config": "workspace:*",
    "@design-assets/typescript-config": "workspace:*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
